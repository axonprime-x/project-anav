        if (matches[j].closest('#sidebar, #sidebar-content') && matches[j].getClientRects().length) {
          item = matches[j];
          break;
        }
      }
    }
    if (!item) return;
    window.__mintlifyInitialSidebarScrollDone = true;

    var parent = item.closest('[data-component-part="scroll-area-viewport"]');
    if (!parent) {
      parent = item.parentElement;
      while (parent) {
        var style = getComputedStyle(parent);
        if (style.overflowY === 'auto' || style.overflowY === 'scroll') break;
        parent = parent.parentElement;
      }
    }
    if (!parent) return;

    var row = item.querySelector(':scope > button') || item;
    var parentRect = parent.getBoundingClientRect();
    var itemRect = row.getBoundingClientRect();
    if (itemRect.top >= parentRect.top && itemRect.bottom <= parentRect.bottom) return;

    var itemTopRelative = itemRect.top - parentRect.top + parent.scrollTop;
    parent.scrollTop = itemTopRelative - parentRect.height / 2 + itemRect.height / 2;
  } catch (e) {}
})();</script></div></div></div></div></div></nav><main id="content-container" class="lg:flex-1 lg:min-w-0"><script>document.documentElement.setAttribute('data-page-mode', "none");</script><style>html{background:rgb(var(--background-light))!important}html.dark{background:rgb(var(--background-dark))!important}html body{background:transparent!important}</style><span class="fixed inset-0 -z-10 pointer-events-none" id="background-color"></span><!--$--><!--/$--><div class="flex flex-row-reverse gap-12 box-border w-full pt-[calc(10rem+var(--banner-height,2.5rem))] lg:pt-10"><div class="hidden xl:flex self-start sticky xl:flex-col max-w-[28rem] z-21 h-[calc(100vh-9.5rem)] top-[9.5rem] [[data-banner-state=visible]_&amp;]:h-[calc(100vh-12rem)] [[data-banner-state=visible]_&amp;]:top-[12rem]" id="content-side-layout" data-layout-item="side-panel"><div class="z-10 hidden xl:flex box-border max-h-full pl-10 w-[19rem]" id="table-of-contents-layout" data-layout-item="toc"><div role="presentation" style="position:relative;--scroll-area-corner-height:0px;--scroll-area-corner-width:0px" data-component-part="scroll-area" id="table-of-contents" data-layout-item="toc-content" data-shell="panel" data-marker="none" data-look="default" class="min-w-0 text-gray-600 text-sm leading-6 w-[16.5rem] -mt-10 group/toc"><div data-id="base-ui-_R_beehkd74t9_-viewport" tabindex="-1" class="size-full rounded-[inherit] [--scroll-area-fade-size:32px] pt-10 pb-4 base-ui-disable-scrollbar" style="overflow:scroll" data-component-part="scroll-area-viewport"><div role="presentation" style="min-width:fit-content" data-component-part="scroll-area-content" class="min-w-0! w-full space-y-2"><nav aria-labelledby="_R_3eehkd74t9_"><h2 id="_R_3eehkd74t9_" data-layout-item="toc-title"><button type="button" aria-describedby="_R_3eehkd74t9H1_"><svg aria-hidden="true" width="18" height="18" stroke-width="2" class="size-3 shrink-0"><use href="#mi-mint-1-TableOfContents"></use></svg><span>On this page</span></button></h2>